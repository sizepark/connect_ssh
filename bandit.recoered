#include <stdio.h>
#include <stdlib.h>
#include <libssh/libssh.h>
#include <unistd.h>
#include <sys/select.h>
#include <string.h>

#define TARGET_USER "bandit0"
#define TARGET_PASS "bandit0"
#define TARGET_HOST "bandit.labs.overthewire.org"
#define TARGET_PORT 2220

int main(){
	ssh_session m_session;
	ssh_channel m_channel;
	int rc;
	int port = TARGET_PORT;

	m_session = ssh_new();
	ssh_options_set(m_session, SSH_OPTIONS_HOST, TARGET_HOST);
	ssh_options_set(m_session, SSH_OPTIONS_PORT, &port);
	ssh_options_set(m_session, SSH_OPTIONS_USER, TARGET_USER);
	
	printf("[+] Connectin to %s on port %d...\n", TARGET_HOST, port);
	rc = ssh_connect(m_session);
	if(rc != SSH_OK){
		fprintf(stderr, "Failed Connect : %s\n", ssh_get_error(m_session));
		goto ERR_SESSION;
	}

	rc = ssh_userauth_password(m_session, NULL, TARGET_PASS);
	if(rc != SSH_OK){
		fprintf(stderr, "Failed UserAuth : %s \n", ssh_get_error(m_session));
		goto ERR_SESSION;
	}

	m_channel = ssh_channel_new(m_session);
	if(m_channel == NULL){
		goto ERR_SESSION;
	}

	rc = ssh_channel_open_session(m_channel);
	if(rc != SSH_OK){
		fprintf(stderr, "Failed UserAuth : %s \n", ssh_get_error(m_session));
		goto ERR_CHANNEL;
	}
	
	char buffer[1024];
	int nbytes;
	rc = ssh_channel_request_exec(m_channel, "ls -al");
	if(rc != SSH_OK){
		fprintf(stderr, "Failed UserAuth : %s \n", ssh_get_error(m_session));
		goto ERR_CHANNEL;
	}

	nbytes = ssh_channel_read(m_channel, buffer, sizeof(buffer), 0);
	
	while (nbytes > 0) {
        if (write(STDOUT_FILENO, buffer, nbytes) != (unsigned int)nbytes) 
			goto ERR_CHANNEL; 
        nbytes = ssh_channel_read(m_channel, buffer, sizeof(buffer), 0);
    }

	ssh_channel_send_eof(m_channel);
	ssh_channel_close(m_channel);
	ssh_channel_free(m_channel);
	ssh_disconnect(m_session);
	ssh_free(m_session);

ERR_CHANNELL:
	ssh_channel_close(m_channel);
	ssh_channel_free(m_channel);
	goto ERR_SESSION;
	
ERR_SESSION:
	ssh_disconnect(m_session);
	ssh_free(m_session);
	goto ERR_EXIT;

ERR_EXIT:
	return -1;

	return 0;
}
